<?xml version="1.0" encoding="utf-8"?>
<!-- build 116 chooser: unselected game tile -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#2C3340" />
            <stroke
                android:width="1dp"
                android:color="#39414F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1D212A" />
            <stroke
                android:width="1dp"
                android:color="#2A303B" />
        </shape>
    </item>
</selector>