<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/settings_title"
                android:textColor="#E8ECF4"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/settings_sub"
                android:textColor="#7E8CA0"
                android:textSize="13sp" />

            <!-- engine log -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.14"
                android:text="@string/settings_section_log"
                android:textColor="#7E8CA0"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:paddingLeft="13dp"
                android:paddingTop="11dp"
                android:paddingRight="13dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/settings_log_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#7E8CA0"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/settings_log_open"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_neutral"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/settings_log_open"
                        android:textColor="#E8ECF4"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/settings_log_share"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_dark"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/settings_log_share"
                        android:textColor="#C9CFDB"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/settings_log_clear"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_dark"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/settings_log_clear"
                        android:textColor="#C9CFDB"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- launch options -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.14"
                android:text="@string/settings_section_launch"
                android:textColor="#7E8CA0"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:paddingLeft="13dp"
                android:paddingTop="6dp"
                android:paddingRight="13dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/row_pressed"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_save" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/settings_opt_log"
                            android:textColor="#E8ECF4"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_opt_log_sum"
                            android:textColor="#7E8CA0"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <su.xash.cs16client.PillSwitch
                        android:id="@+id/settings_opt_log"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="11dp"
                    android:background="#2A303B" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/row_pressed"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warn" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/settings_opt_dev"
                            android:textColor="#E8ECF4"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_opt_dev_sum"
                            android:textColor="#7E8CA0"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <su.xash.cs16client.PillSwitch
                        android:id="@+id/settings_opt_dev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- A7 build 136 (item 1): Steam account card - shows the
                 connected SteamID64 with the Steam logo, tap opens the
                 sign-in/friends WebView (su.xash.engine.SteamFriendsActivity) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.14"
                android:text="@string/settings_section_steam"
                android:textColor="#7E8CA0"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/settings_steam_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_dark"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingLeft="13dp"
                android:paddingTop="11dp"
                android:paddingRight="13dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/settings_steam_logo"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_steam" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/settings_steam_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/settings_steam_not_signed"
                            android:textColor="#E8ECF4"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/settings_steam_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#7E8CA0"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/settings_steam_open"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_neutral"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_steam_open"
                    android:textColor="#E8ECF4"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- about -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.14"
                android:text="@string/settings_section_about"
                android:textColor="#7E8CA0"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:paddingLeft="13dp"
                android:paddingTop="11dp"
                android:paddingRight="13dp"
                android:paddingBottom="11dp">

                <TextView
                    android:id="@+id/settings_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#D6E2F0"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#2A303B" />

                <TextView
                    android:id="@+id/settings_engine_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#D6E2F0"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- bottom tabs (shared with launcher/plugins/modules/compiler) -->
    <include layout="@layout/tab_bar" />

</LinearLayout>
